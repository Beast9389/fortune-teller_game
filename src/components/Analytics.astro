---
/**
 * Google Analytics 4 (GA4) snippet.
 *
 * IMPORTANT: replace GA_MEASUREMENT_ID below with your real Measurement ID
 * (looks like "G-XXXXXXXXXX"). Get one at https://analytics.google.com —
 * Admin -> Data Streams -> Web -> your site -> Measurement ID.
 *
 * This only loads in production builds (npm run build / your deployed
 * site) so local `npm run dev` traffic doesn't pollute your analytics.
 */
const GA_MEASUREMENT_ID = "G-XXXXXXXXXX"; // <-- replace with your real ID
const isProd = import.meta.env.PROD;
const isConfigured = GA_MEASUREMENT_ID !== "G-XXXXXXXXXX";
---

{isProd && isConfigured && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
  </>
)}
