---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import ArcaneArcade from '../components/ArcaneArcade.jsx';
import SEO from '../components/SEO.astro';
import FAQ from '../components/FAQ.astro';

const faqItems = [
  {
    q: "What is a fortune teller?",
    a: "A fortune teller is a person or, in this case, a tool that uses cards, symbols, or a set of questions to give playful insight or predictions about your life, personality, or relationships. On My Fortune, every reading is generated by a fair algorithm for entertainment — not a real prediction.",
  },
  {
    q: "How does a fortune teller work?",
    a: "Traditional fortune tellers use tools like tarot cards, palm lines, or a crystal ball paired with intuition. Our online fortune teller instead uses cryptographically fair shuffling and, for the AI Fortune Teller game, an AI model to write your result — with everything processed either instantly or fully in your browser.",
  },
  {
    q: "Is there a free online fortune teller?",
    a: "Yes — My Fortune is completely free, with no account or sign-up required. You can try the AI Fortune Teller, Digital Tarot draw, Crystal Ball-style Scrying Pool, and more, all at no cost.",
  },
  {
    q: "What does 'fortune teller' mean?",
    a: "A fortune teller (भविष्यवक्ता — bhavishyavakta in Hindi) is someone believed to predict future events, often using tools like tarot cards, palmistry, or astrology. On this site, it refers to a fun, algorithm-based game rather than a real predictive service.",
  },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<SEO
			title="Digital Tarot & Free Online Fortune Teller"
			description="Play free online fortune teller games: AI fortune teller, digital tarot draws, crystal ball scrying, palm reader, and soulmate quiz. No account, no pop-ups, fair random results."
			keywords={[
				"fortune teller ai",
				"fortune teller game",
				"online fortune teller",
				"fortune teller online free by date of birth",
				"crystal ball fortune teller online free",
				"crystal ball fortune teller",
				"free fortune teller",
				"ai fortune teller online free",
			]}
		/>
			<Analytics />
	</head>
	<body>
		<ArcaneArcade client:load />
		<FAQ items={faqItems} />
	</body>
</html>