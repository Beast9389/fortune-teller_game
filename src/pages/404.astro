---
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page not found — My Fortune</title>
  <meta name="robots" content="noindex" />
  <Analytics />
</head>
<body class="err-body">
  <div class="err-wrap">
    <p class="err-code">404</p>
    <h1>The pool doesn't show what isn't there.</h1>
    <p class="err-sub">This page doesn't exist — it may have moved, or the link might be wrong.</p>
    <a href="/" class="err-btn">Back to My Fortune</a>
  </div>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Manrope:wght@400;600;700&display=swap');
    body.err-body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; background:#0B0B14; color:#F3ECE0; font-family:'Manrope',sans-serif; text-align:center; padding:24px; }
    .err-wrap { max-width:420px; }
    .err-code { font-family:'Cinzel',serif; font-size:64px; font-weight:700; color:#8B5CF6; margin:0 0 6px; text-shadow:0 0 40px rgba(139,92,246,.5); }
    .err-wrap h1 { font-family:'Cinzel',serif; font-size:22px; margin:0 0 10px; }
    .err-sub { color:#9490A8; font-size:14px; margin:0 0 26px; }
    .err-btn { display:inline-flex; padding:12px 26px; border-radius:99px; background:linear-gradient(135deg,#E8C766,#C9A227); color:#1a1408; font-weight:700; font-size:14px; text-decoration:none; }
  </style>
</body>
</html>
