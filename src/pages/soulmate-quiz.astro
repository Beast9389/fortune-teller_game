    type OptionDef = { label: string; vector: number[] };
    type QuestionDef = { id: number; text: string; img: string; options: OptionDef[] };
    type Persona = { name: string; desc: string; vector: number[] };
    type Mode = "solo" | "pass" | "challenge";

    const TRAITS = ["Independence", "Empathy", "Ambition", "Spontaneity", "Intellect"];
    const TRAIT_COUNT = TRAITS.length;

    // ---------- crypto-secure randomness ----------
    function secureRandomInt(maxExclusive: number): number {
      const arr = new Uint32Array(1);
      const limit = 0xFFFFFFFF - (0xFFFFFFFF % maxExclusive);
      let val: number;
      do {
        crypto.getRandomValues(arr);
        val = arr[0];
      } while (val >= limit);
      return val % maxExclusive;
    }
    function secureShuffle<T>(arr: T[]): T[] {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = secureRandomInt(i + 1);
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    // ---------- image pool (Picsum — no keys, no breakage) ----------
    const IMG_IDS = [1011, 1012, 1013, 1014, 1015, 1016, 1018, 1019, 1020, 1021,
      1022, 1023, 1024, 1025, 1027, 1028, 1029, 1031, 1033, 1035,
      1036, 1037, 1039, 1041, 1042, 1043, 1044, 1045, 1047, 1049];
