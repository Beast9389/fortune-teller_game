      return `https://picsum.photos/id/${IMG_IDS[id % IMG_IDS.length]}/1200/700`;
    }

    // ---------- question pool ----------
    // Structured so this array can scale to 400 questions without any code
    // changes — just append more { id, text, img, options } objects.
